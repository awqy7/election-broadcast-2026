# tse = oficial; tse-sim = simulado hospedado pelo TSE; mock = ensaio local
DATA_MODE=tse
# pnpm start:sim usa porta própria e desativa os comandos da API vMix.
SIM_PORT=8788
HOST=127.0.0.1
PORT=8787
# Defina uma chave de pelo menos 16 caracteres. Sem ela, o servidor gera data/admin-access-key.txt.
ADMIN_ACCESS_KEY=
TSE_HOST=resultados.tse.jus.br
# 1 = 1º turno; 2 = 2º turno (padrão para 25/10/2026)
TSE_ROUND=2
TSE_POLL_INTERVAL_MS=10000
# Mapa: 1 UF a cada 2s (27 UFs em ~54s, abaixo de 1 req/s)
TSE_MAP_POLL_INTERVAL_MS=2000
TSE_MIN_REQUEST_INTERVAL_MS=1000
TSE_TIMEOUT_MS=10000
DEFAULT_UF=mg
DEFAULT_MUNICIPALITY_NAME=Teófilo Otoni
VMIX_ENABLED=false
VMIX_HOST=127.0.0.1
VMIX_PORT=8088
VMIX_INPUT_NAME=ELECTION_OVERLAY
VMIX_OVERLAY_CHANNEL=1
